    <string name="app_name">Lean Cleaner</string>
    <string name="accessibility_service_label">Lean Cleaner: clear app caches</string>
    <string name="accessibility_service_description">Lets Lean Cleaner clear the cache of all your apps with one tap. When you start a cleaning run, it opens each app\'s Storage page in Settings and presses \"Clear cache\" for you. It is only active during a run you start, only acts on the Settings app, never touches app data or anything else, and nothing leaves your phone (the app has no internet access).</string>
    <string name="automation_overlay_title">Clearing app caches</string>
    <string name="automation_overlay_hint">Lean Cleaner is pressing \"Clear cache\" in Settings for you. Please don\'t touch the screen.</string>
