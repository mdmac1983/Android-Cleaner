<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shared storage access. Android 8-10 use the classic permissions,
         Android 11+ uses "All files access" so junk, leftovers and duplicates can be found. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- App sizes, cache sizes and "last used" dates (granted by the user in Settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to tell leftovers of uninstalled apps apart from data of installed ones. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Launch the system uninstall dialog for (batch) uninstalls. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Deliberately no INTERNET permission: nothing ever leaves the device. -->

    <application
        android:name=".LeanCleanerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeanCleaner"
        tools:targetApi="36">

        <!-- singleTask: when opened from Settings ("Free up space") the app still gets its own task,
             so the cache-cleaning automation (which clears Settings' task) can't close it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shows up as "Manage storage" / free-up-space entry point in system storage settings. -->
            <intent-filter>
                <action android:name="android.os.storage.action.MANAGE_STORAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Widget buttons go through this non-exported alias, so other apps can't trigger their actions. -->
        <activity-alias
            android:name=".WidgetAction"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Home screen widgets. They only update while the phone is awake (no wakeups, no service). -->
        <receiver
            android:name=".widget.StatsWidget"
            android:exported="true"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>
        <receiver
            android:name=".widget.QuickCleanWidget"
            android:exported="true"
            android:label="@string/widget_quick_clean_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_clean_info" />
        </receiver>

        <!-- Optional "clear all app caches" automation; does nothing until the user starts a run. -->
        <service
            android:name=".automation.CacheCleanerService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
